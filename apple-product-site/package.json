  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "server": "tsx server/index.ts",
    "build:deck": "cd \"momentumSlideDeck 2\" && find ../public -maxdepth 1 -name \"Screenshot*.png\" -exec cp {} public/ \\; && npm install && npm run build && chmod 644 public/*.* out/*.* 2>/dev/null || true && cd .. && mkdir -p public/deck && cp -r \"momentumSlideDeck 2/out\"/* public/deck/ && chmod 644 public/deck/*.* 2>/dev/null || true && cp public/deck/deck.html public/deck/index.html && cp public/deck/logo.png public/logo.png 2>/dev/null; cp public/deck/*.jpeg public/ 2>/dev/null; cp public/deck/*.jpg public/ 2>/dev/null; cp public/deck/*.mp4 public/ 2>/dev/null; cp public/deck/Screenshot*.png public/ 2>/dev/null || true",
    "dev:deck": "cd \"momentumSlideDeck 2\" && npm run dev",
    "dev": "npm run build:deck && concurrently \"npm run server\" \"BROWSER=none PORT=3001 npm start\"",
    "prod": "npm run build:deck && npm run build && npm run server"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
