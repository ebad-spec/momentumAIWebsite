run = "cowsay Configure me!"
entrypoint = "README.md"
modules = ["nodejs-20", "python-3.11"]

[nix]
channel = "stable-24_05"
packages = ["cowsay", "imagemagick_light"]

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 3002
externalPort = 3002

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 5002
externalPort = 3003

[deployment]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "npm run build:deck --prefix apple-product-site && npm run build --prefix apple-product-site"]
run = ["sh", "-c", "npm run server --prefix apple-product-site"]

[agent]
expertMode = true
integrations = ["resend:1.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apple-product-site && npm run build && tsx server/index.ts"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
